      "command": "python3 -c 'import json\nfrom pathlib import Path\nbase=Path('\"'\"'docs/superpowers/reports/assets/issue230'\"'\"')\nfor rel,key in [('\"'\"'all/all.json'\"'\"','\"'\"'assertions'\"'\"'),('\"'\"'all/appearance/appearance.json'\"'\"','\"'\"'assertions'\"'\"'),('\"'\"'security/security.json'\"'\"','\"'\"'assertions'\"'\"'),('\"'\"'shell/checks.json'\"'\"','\"'\"'checks'\"'\"')]:\n    d=json.loads((base/rel).read_text())\n    values=d[key]\n    if key == '\"'\"'checks'\"'\"':\n        assert len(values) == 51\n        bad=[x for x in values if not ((isinstance(x,str) and bool(x)) or (isinstance(x,dict) and x.get('\"'\"'width'\"'\"') == x.get('\"'\"'scroll'\"'\"')))]\n    elif isinstance(values,dict):\n        bad=[k for k,v in values.items() if v is not True]\n    else:\n        bad=[x for x in values if x.get('\"'\"'pass'\"'\"') is not True]\n    unknown=d.get('\"'\"'unknown'\"'\"',d.get('\"'\"'unknownRequests'\"'\"',[]))\n    errors=d.get('\"'\"'pageErrors'\"'\"',[])\n    assert not bad and not unknown and not errors, (rel,bad,unknown,errors)\n    print(f'\"'\"'{rel}: {len(values)} passed; unknown=0; pageErrors={len(errors)}'\"'\"')\n'",
