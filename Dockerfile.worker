# Celery Worker 镜像（issue #159）：附带 docker CLI 供沙箱预检调用。
# 宿主 Docker daemon 通过 compose 挂载的 /var/run/docker.sock 访问，
# 仅在信任该机器的用户提交代码时启用（沙箱以宿主 docker 运行不受信代码）。
# 构建：docker build -f Dockerfile.worker -t llm-harness-worker .

FROM python:3.11-slim AS builder
WORKDIR /build
COPY requirements.txt ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

FROM python:3.11-slim AS runtime

# 静态链接的 docker CLI（来自官方 docker:cli 镜像），不含 daemon
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker

# procps 供 beat 容器的 pgrep 健康检查使用
RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 harness \
    && useradd --uid 1000 --gid harness --create-home --shell /usr/sbin/nologin harness

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LOG_FORMAT=json

WORKDIR /app
COPY --chown=harness:harness api/ ./api/
COPY --chown=harness:harness src/ ./src/

RUN mkdir -p data/business data/auth data/tasks uploads \
    && chown -R harness:harness data uploads

USER harness

CMD ["sh", "-c", "celery -A src.celery_app worker --loglevel=${LOG_LEVEL:-INFO} --concurrency=2 --max-tasks-per-child=50 --queues=evaluations,default --hostname=worker@%h"]
