{
  "dataset_path": "data/problems.json",
  "output_dir": "./results",
  "models": [
    {
      "name": "small-model",
      "llm_config": {
        "provider": "siliconflow",
        "api_key": "env:SILICONFLOW_API_KEY",
        "model": "Qwen/Qwen2.5-7B-Instruct",
        "temperature": 0.7,
        "max_tokens": 1000,
        "timeout": 30
      },
      "price": null
    }
  ],
  "strategies": [
    {"name": "vanilla", "max_iterations": 1},
    {"name": "chain_of_thought", "max_iterations": 1},
    {"name": "multi_round_feedback", "max_iterations": 3}
  ],
  "sandbox_config": {"backend": "docker", "docker_image": "python:3.11-slim"},
  "repetitions": 2,
  "max_workers": 1,
  "budget": {"max_calls": 3, "max_total_tokens": 3000, "max_elapsed_seconds": 120}
}
