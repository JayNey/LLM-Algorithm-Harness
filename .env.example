# LLM-Algorithm-Harness 环境配置样例（issue #159）
#
# 使用方式：复制为 .env 并按环境修改。容器部署时由 compose 的 env_file 注入。
# 必填项：SECRET_KEY、ENCRYPTION_KEY（生产缺失时应用启动校验会失败并指明变量名）。
# LLM 提供商的 API Key 不走环境变量，请在 Web 界面或应用配置文件中填写。
# 本文件须与 api/config.py、api/auth/config.py、api/files/config.py 的
# Settings 字段保持一致（tests/test_deployment_config.py 有防漂移检查）。

# ---------- 服务器（api/config.py Settings） ----------
# 注意：Settings 字段名是 HOST/PORT（env 文件按字段名匹配）；
# API_HOST/API_PORT 仅在作为真实环境变量导出时生效（compose 的 environment 可用）。
# 裸机默认只监听本机回环；容器部署由 compose 覆盖为 0.0.0.0
HOST=127.0.0.1
PORT=8000
# JSON 数组格式；生产改为你的前端来源
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT_SECONDS=3600

# ---------- 数据库 ----------
# 默认留空使用本地 SQLite（data/business/business.sqlite3）；
# 生产指向 PostgreSQL，例如：
#   postgresql+psycopg://harness:password@postgres:5432/harness
DATABASE_URL=
# 业务数据根目录（数据集等）
DATA_ROOT=data
# TaskService 存储路径
TASK_SERVICE_ROOT=./data/tasks

# ---------- Redis / Celery ----------
# 裸机/本地开发用 localhost；容器部署由 compose 的 environment 覆盖为服务名
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------- 容器部署专用（docker-compose.prod.yml） ----------
# 宿主 docker 组的 GID（worker 沙箱访问 /var/run/docker.sock 用），查询方式：
#   stat -c %g /var/run/docker.sock
# 生产编排未设置时拒绝启动
DATABASE_PASSWORD=change-me-postgres-password
DOCKER_GID=999

# ---------- 认证密钥（api/auth/config.py AuthSettings，必填） ----------
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 要求：至少 32 字节
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
# 生成：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 要求：合法的 Fernet 密钥（用于 API Key 加密存储）
ENCRYPTION_KEY=change-me-generate-with-fernet-generate-key
# 认证库文件（独立于业务库）
AUTH_DATABASE_PATH=data/auth/auth.sqlite3
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
AUTH_PROTECTED_RATE_LIMIT=120

# ---------- 文件上传与导入（api/files/config.py FileSettings） ----------
UPLOAD_DIR=uploads
FILE_UPLOAD_MAX_BYTES=104857600          # 100 MiB，nginx client_max_body_size 需与此对齐
FILE_CONFIG_MAX_BYTES=1048576            # 1 MiB
FILE_MAX_USER_BYTES=536870912            # 512 MiB
FILE_TTL_SECONDS=86400
FILE_CLEANUP_INTERVAL_SECONDS=300
FILE_UPLOAD_RATE_LIMIT=10
FILE_MAX_CONCURRENT_TRANSFERS=2
FILE_UPLOAD_TIMEOUT_SECONDS=120
FILE_UPLOAD_IDLE_SECONDS=15
FILE_MAX_CONCURRENT_IMPORTS=2
FILE_MAX_ACTIVE_IMPORTS=8
FILE_IMPORT_MAX_ITEMS=10000
FILE_IMPORT_TIMEOUT_SECONDS=3600

# ---------- 日志（api/logging_config.py） ----------
# 级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 格式：text（默认，人类可读）| json（生产推荐，结构化输出）
LOG_FORMAT=text
