{
  "dataset_path": "data/problems.json",
  "output_dir": "./results",
  "max_workers": 5,
  "llm_config": {
    "provider": "openai",
    "api_key": "env:OPENAI_API_KEY",
    "model": "gpt-3.5-turbo",
    "temperature": 0.7,
    "max_tokens": 2000,
    "timeout": 30,
    "retry_max_attempts": 3,
    "retry_backoff_seconds": 0.5
  },
  "sandbox_config": {
    "backend": "docker",
    "docker_image": "python:3.11-slim",
    "timeout_seconds": 5,
    "memory_limit_mb": 256,
    "max_output_bytes": 1000000,
    "max_processes": 16,
    "allowed_imports": [
      "math",
      "itertools",
      "collections",
      "functools",
      "heapq",
      "bisect",
      "re",
      "string"
    ]
  },
  "strategies": [
    {
      "name": "vanilla",
      "max_iterations": 1
    },
    {
      "name": "chain_of_thought",
      "max_iterations": 1
    },
    {
      "name": "multi_round_feedback",
      "max_iterations": 3
    },
    {
      "name": "self_consistency",
      "max_iterations": 1,
      "custom_params": {
        "num_candidates": 5
      }
    },
    {
      "name": "reflexion",
      "max_iterations": 3,
      "custom_params": {
        "reflection_context_chars": 6000
      }
    },
    {
      "name": "few_shot_learning",
      "max_iterations": 1,
      "custom_params": {
        "num_examples": 3,
        "similarity_metric": "tag_overlap",
        "min_similarity_score": 0.3,
        "example_source": "solved_problems"
      }
    },
    {
      "name": "tree_of_thoughts",
      "max_iterations": 1,
      "custom_params": {
        "branching_factor": 3,
        "max_depth": 4,
        "search_strategy": "bfs",
        "pruning_threshold": 0.3
      }
    }
  ],
  "problem_filters": {
    "difficulty": null,
    "tags": null,
    "limit": null
  }
}
