{
  "dataset_path": "data/problems.json",
  "output_dir": "./results",
  "llm_config": {
    "provider": "openai",
    "api_key": "env:OPENAI_API_KEY",
    "model": "gpt-3.5-turbo",
    "temperature": 0.7,
    "max_tokens": 2000,
    "timeout": 30
  },
  "sandbox_config": {
    "backend": "docker",
    "docker_image": "python:3.11-slim",
    "timeout_seconds": 5,
    "memory_limit_mb": 256,
    "max_output_bytes": 1000000,
    "max_processes": 16,
    "allowed_imports": [
      "math",
      "itertools",
      "collections",
      "functools",
      "heapq",
      "bisect",
      "re",
      "string"
    ]
  },
  "strategies": [
    {
      "name": "vanilla",
      "max_iterations": 1
    },
    {
      "name": "chain_of_thought",
      "max_iterations": 1
    },
    {
      "name": "multi_round_feedback",
      "max_iterations": 3
    }
  ],
  "problem_filters": {
    "difficulty": null,
    "tags": null,
    "limit": null
  }
}
